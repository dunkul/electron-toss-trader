# Toss Securities Open API
# 발급: 토스증권 WTS 로그인 > 설정 > Open API
# client_id/client_secret은 이제 앱 안의 설정 탭에서 등록하면 암호화되어 저장됩니다.
# 여기 값은 앱 설정 탭에 아직 아무것도 저장되지 않았을 때만 쓰이는 개발용 폴백입니다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_API_BASE_URL=https://openapi.tossinvest.com
TOSS_WS_URL=wss://openapi-ws.tossinvest.com/ws/v1

# 로깅: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# DB 파일 경로 (미지정 시 Electron userData 경로 사용)
DB_PATH=
